{
  "name": "divyadham",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node scripts/build.mjs",
    "start": "next start -p 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:push": "node scripts/prisma-provider.mjs && prisma db push",
    "db:seed": "node scripts/prisma-provider.mjs && tsx prisma/seed.ts",
    "db:reset": "node scripts/prisma-provider.mjs && prisma db push --force-reset && tsx prisma/seed.ts",
    "db:studio": "node scripts/prisma-provider.mjs && prisma studio",
    "cron:reminders": "tsx scripts/run-reminders.ts",
    "setup": "npm install && npm run db:push && npm run db:seed",
    "prisma:prepare": "node scripts/prisma-provider.mjs",
    "postinstall": "node scripts/prisma-provider.mjs && prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.43.0",
    "mhah-panchang": "^1.2.0",
    "next": "15.5.25",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "suncalc": "^2.0.2",
    "tailwind-merge": "^3.3.1",
    "web-push": "^3.6.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/suncalc": "^1.9.2",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "prisma": "6.19.3",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.20.0",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
