DATABASE_URL="file:./dev.db"
AUTH_SECRET="divyadham-dev-secret-change-me-in-production-0123456789"
NEXT_PUBLIC_APP_NAME="DivyaDham"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# OTP: in dev, OTP is fixed to 123456 and also printed to the server console
OTP_DEV_CODE="123456"
# Payments: "mock" (built-in simulator) or "razorpay"
PAYMENT_PROVIDER="mock"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Web push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@divyadham.app"
# Secret for /api/cron/* endpoints
CRON_SECRET="dev-cron-secret"
# Seeded admin credentials
ADMIN_EMAIL="admin@divyadham.app"
ADMIN_PASSWORD="Admin@123"

# OTP SMS delivery: "console" (dev; fixed OTP_DEV_CODE) or "renflair" (https://renflair.in — set RENFLAIR_API_KEY)
SMS_PROVIDER="console"
RENFLAIR_API_KEY=""
# "sms" (V1) or "voice" (V2 voice call) — Renflair only
RENFLAIR_CHANNEL="sms"

# Where uploaded public images go: Vercel Blob when BLOB_READ_WRITE_TOKEN is set, otherwise the
# database on serverless hosts and public/uploads/ elsewhere. KYC documents are always private in the
# database. Force a backend with UPLOAD_STORAGE=database|disk.
# UPLOAD_STORAGE=
